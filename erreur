from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI()

etat_capteurs = {"luminosite": 0, "bouton": 0}

class Capteurs(BaseModel):
    luminosite: float
    bouton: int

@app.post("/update")
def update_capteurs(data: Capteurs):
    etat_capteurs["luminosite"] = data.luminosite
    etat_capteurs["bouton"] = data.bouton
    return {"status": "ok"}

@app.get("/capteurs")
def lire_capteurs():
    return etat_capteurs

